# =============================================================================
# Environment variables — Shubham Badgujar portfolio
# =============================================================================
#
# Copy to `.env` for local use:
#
#     cp .env.example .env        (macOS / Linux)
#     copy .env.example .env      (Windows CMD)
#
# The asset scripts read it via `node --env-file-if-exists=.env`, so a `.env` in
# the project root is picked up automatically and its absence is not an error.
#
# IMPORTANT
# The site itself reads NO environment variables. `src/` contains zero
# references to `process.env` — every piece of content is committed data under
# `src/data/`, so the app builds and runs with no configuration at all.
#
# Everything below is optional and used only by the local asset-preparation and
# screenshot scripts in `scripts/`. Netlify needs none of it, except the build
# image settings noted at the bottom.
#
# Put no secrets in this file. It is committed. Real values belong in
# `.env`, which is git-ignored.
# =============================================================================


# -----------------------------------------------------------------------------
# Avatar cut-out — `npm run avatar`
# Rebuilds the transparent portrait plate from a source photograph.
# -----------------------------------------------------------------------------

# Source photograph to cut out.
# AVATAR_SRC="assets/your-photo.jpeg"

# Where the finished RGBA image is written.
# AVATAR_OUT="public/images/shubham-profile.webp"

# Debug: write a preview of the cut-out composited on the site background.
# AVATAR_PREVIEW="scripts/_preview.png"

# Debug: print the computed mask as ASCII. "1" = final mask, "2" = both passes.
# AVATAR_ASCII="1"


# -----------------------------------------------------------------------------
# Hero video — `npm run hero:video`
# Re-encodes the looping hero background from a source clip.
# -----------------------------------------------------------------------------

# Source video to process.
# HERO_SRC="assets/your-video.mp4"

# Debug: print the loop-seam measurement against a normal frame step.
# HERO_SEAM="1"


# -----------------------------------------------------------------------------
# Screenshot helper — `node scripts/shots.mjs`
# Local-only visual check; drives headless Chrome over CDP.
# -----------------------------------------------------------------------------

# Base URL to capture. Defaults to http://localhost:3000
# BASE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Netlify build image (set in the Netlify UI or netlify.toml, not here)
# -----------------------------------------------------------------------------
#
#   NODE_VERSION=22     Next.js 16 needs Node 20.9+; this repo pins 20.12+
#                       because the asset scripts use --env-file-if-exists.
#
# Already declared in netlify.toml, so it does not need setting by hand.
